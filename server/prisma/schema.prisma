// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 — IT request categories (unchanged from Issue 3 migration)
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 — Issue 2: Data model for Tickets, Attachments, Requesters, Systems
// ---------------------------------------------------------------------------

// Development Requester: stands in for a real user until Lab 3 auth.
// BR-05: only isActive = true records appear in the selector dropdown.
// BR-22: inactivation does not retroactively affect existing Tickets.
model DevelopmentRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Related System: the IT asset/service the Ticket concerns.
// BR-12: submitting an inactive or unknown relatedSystemId is rejected 400.
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// BR-13: requestedPriority must be one of LOW / MEDIUM / HIGH.
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

// BR-02: only NEW is reachable in Lab 2 scope.
enum TicketStatus {
  NEW
  // OPEN, IN_PROGRESS, RESOLVED, CLOSED, CANCELLED reserved for later labs
}

// Ticket: core entity.
// BR-01: ticketNumber is globally unique, generated by the server.
// BR-02: currentStatus defaults to NEW.
// BR-04: ticketOwnerId and itPriority are nullable (IT Staff assigns later).
// BR-07: requesterId is fixed at creation, never reassigned.
// BR-25: schema designed so Lab 3 auth swap needs no schema migration.
model Ticket {
  id                Int                  @id @default(autoincrement())
  ticketNumber      String               @unique
  requesterId       Int
  requester         DevelopmentRequester @relation(fields: [requesterId], references: [id])
  categoryId        Int
  category          Category             @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem        @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        RequestedPriority?
  currentStatus     TicketStatus         @default(NEW)
  ticketOwnerId     Int?                 // nullable Int — IT Staff id, no FK in Lab 2
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attachments       Attachment[]

  @@index([requesterId])   // ownership filtering (BR-08)
  @@index([categoryId])    // category filter on GET /api/tickets
  @@index([currentStatus]) // status filter on GET /api/tickets
}

// Attachment: file evidence attached to a Ticket.
// BR-18: storedFileName is server-generated and unique — prevents path traversal.
// BR-19: active attachment = removedAt IS NULL; limit of 5 enforced in API.
// BR-20: soft removal sets removedAt + removedReason; row is never deleted.
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  originalFileName String
  storedFileName   String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removedReason    String?

  @@index([ticketId]) // fetching all attachments for a given Ticket
}


